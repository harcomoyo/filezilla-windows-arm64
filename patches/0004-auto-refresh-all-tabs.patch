+void CMainFrame::UpdateAutoRefreshTimer()
+{
+	bool const enabled = options_.get_int(OPTION_AUTOREFRESH_ALL_TABS) != 0;
+	long const seconds = options_.get_int(OPTION_AUTOREFRESH_INTERVAL);
+	if (!enabled || seconds < 1) {
+		if (m_autoRefreshTimer.IsRunning()) {
+			m_autoRefreshTimer.Stop();
+		}
+		return;
+	}
+	m_autoRefreshTimer.Start(static_cast<int>(seconds * 1000));
+}
+
+void CMainFrame::RefreshAllTabs()
+{
+	CContextManager* const manager = CContextManager::Get();
+	if (!manager) {
+		return;
+	}
+	auto const* states = manager->GetAllStates();
+	if (!states) {
+		return;
+	}
+	for (auto* pState : *states) {
+		if (pState && pState->IsRemoteConnected() && pState->IsRemoteIdle(true)) {
+			pState->RefreshRemote(false);
+		}
+	}
+}
