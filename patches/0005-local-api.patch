diff --git a/src/interface/local_api.cpp b/src/interface/local_api.cpp
new file mode 100644
index 0000000..571e973
--- /dev/null
+++ b/src/interface/local_api.cpp
@@ -0,0 +1,461 @@
+#include "filezilla.h"
+#include "local_api.h"
+
+#ifdef __WXMSW__
+#include "Mainfrm.h"
+#include "QueueView.h"
+#include "context_control.h"
+#include "../include/directorylisting.h"
+#include <sddl.h>
+#include <algorithm>
+#include <set>
+
+namespace {
+constexpr size_t max_request = 64 * 1024;
+constexpr size_t max_response = 1024 * 1024;
+constexpr DWORD timeout_ms = 5000;
+
+bool Members(fz::json const& value, std::initializer_list<char const*> allowed)
+{
+	size_t count{};
+	for (auto key : allowed) {
+		if (value[key]) ++count;
+	}
+	return count == value.children();
+}
+
+// fz::json has already validated syntax. Scan only object member names, since
+// its object map otherwise hides duplicate keys (including escaped aliases).
+bool UniqueMembers(std::string const& input)
+{
+	std::vector<std::set<std::string>> objects;
+	for (size_t i{}; i < input.size();) {
+		char c = input[i++];
+		if (c == '{') objects.emplace_back();
+		else if (c == '}') objects.pop_back();
+		else if (c == '"') {
+			size_t start = i - 1;
+			while (i < input.size()) {
+				char next = input[i++];
+				if (next == '\\') ++i;
+				else if (next == '"') break;
+			}
+			auto next = input.find_first_not_of(" \t\r\n", i);
+			if (next != std::string::npos && input[next] == ':') {
+				auto key = fz::json::parse(std::string_view(input).substr(start, i - start)).string_value();
+				if (!objects.back().insert(std::move(key)).second) return false;
+			}
+		}
+	}
+	return true;
+}
+
+fz::json ErrorResponse(fz::json const& id, int code, char const* message)
+{
+	fz::json reply;
+	reply["jsonrpc"] = "2.0";
+	reply["id"] = id ? id : fz::json(fz::json_type::null);
+	reply["error"]["code"] = code;
+	reply["error"]["message"] = message;
+	return reply;
+}
+
+std::string Encode(fz::json const& reply)
+{
+	auto text = reply.to_string();
+	if (text.size() >= max_response) {
+		text = ErrorResponse(reply["id"], -32003, "Response too large; use a smaller page").to_string();
+	}
+	return text + '\n';
+}
+
+bool Integer(fz::json const& value, int64_t& result)
+{
+	if (!value.is_number()) {
+		return false;
+	}
+	auto text = value.string_value();
+	auto first = !text.empty() && text[0] == '-' ? 1u : 0u;
+	if (first == text.size() || text.find_first_not_of("0123456789", first) != std::string::npos) {
+		return false;
+	}
+	auto number = value.number_value_o<int64_t>();
+	if (!number) {
+		return false;
+	}
+	result = *number;
+	return true;
+}
+}
+
+LocalApi::LocalApi(CMainFrame& frame)
+	: frame_(frame), timer_(this)
+{
+	Bind(wxEVT_TIMER, &LocalApi::Tick, this);
+	CContextManager::Get()->RegisterHandler(this, STATECHANGE_REMOVECONTEXT, false);
+}
+
+LocalApi::~LocalApi()
+{
+	Stop();
+}
+
+void LocalApi::OnStateChange(CState* state, t_statechange_notifications notification, std::wstring const&, void const*)
+{
+	if (notification == STATECHANGE_REMOVECONTEXT) {
+		ForgetSession(state);
+	}
+}
+
+void LocalApi::ForgetSession(CState* state)
+{
+	ids_.erase(state);
+}
+
+bool LocalApi::IsSession(CState* state) const
+{
+	auto* context = frame_.GetContextControl();
+	auto* controls = context ? context->GetControlsFromState(state) : nullptr;
+	return controls && controls->used();
+}
+
+std::string LocalApi::Id(CState* state)
+{
+	auto& id = ids_[state];
+	if (id.empty()) {
+		id = "s-" + std::to_string(++next_id_);
+	}
+	return id;
+}
+
+wxString LocalApi::Status()
+{
+	std::lock_guard<std::mutex> lock(mutex_);
+	return status_;
+}
+
+void LocalApi::Error(DWORD code)
+{
+	std::lock_guard<std::mutex> lock(mutex_);
+	status_ = wxString::Format(L"Error: Win32 %lu", static_cast<unsigned long>(code));
+}
+
+void LocalApi::Start()
+{
+	Stop();
+	// An explicit, protected DACL grants only the process user's SID access.
+	HANDLE token{};
+	DWORD bytes{};
+	PSECURITY_DESCRIPTOR descriptor{};
+	LPWSTR sid{};
+	bool secure = false;
+	if (OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) {
+		GetTokenInformation(token, TokenUser, nullptr, 0, &bytes);
+		std::vector<unsigned char> user(bytes);
+		if (bytes && GetTokenInformation(token, TokenUser, user.data(), bytes, &bytes) &&
+			ConvertSidToStringSidW(reinterpret_cast<TOKEN_USER*>(user.data())->User.Sid, &sid)) {
+			std::wstring dacl = L"D:P(A;;GA;;;" + std::wstring(sid) + L")";
+			secure = ConvertStringSecurityDescriptorToSecurityDescriptorW(dacl.c_str(), SDDL_REVISION_1, &descriptor, nullptr) != FALSE;
+		}
+	}
+	DWORD error = GetLastError();
+	if (sid) LocalFree(sid);
+	if (token) CloseHandle(token);
+	if (!secure) {
+		Error(error);
+		return;
+	}
+	SECURITY_ATTRIBUTES attributes{sizeof(attributes), descriptor, FALSE};
+	auto name = L"\\\\.\\pipe\\filezilla-api-" + std::to_wstring(GetCurrentProcessId());
+	pipe_ = CreateNamedPipeW(name.c_str(), PIPE_ACCESS_DUPLEX | FILE_FLAG_OVERLAPPED | FILE_FLAG_FIRST_PIPE_INSTANCE,
+		PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_WAIT | PIPE_REJECT_REMOTE_CLIENTS,
+		1, 16384, 16384, 0, &attributes);
+	error = GetLastError();
+	LocalFree(descriptor);
+	if (pipe_ == INVALID_HANDLE_VALUE) {
+		Error(error);
+		return;
+	}
+	stop_ = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+	done_ = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+	io_event_ = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+	if (!stop_ || !done_ || !io_event_) {
+		error = GetLastError();
+		Stop();
+		Error(error);
+		return;
+	}
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		status_ = L"Listening: " + wxString(name);
+	}
+	try {
+		worker_ = std::thread(&LocalApi::Run, this);
+	}
+	catch (...) {
+		Stop();
+		Error(ERROR_NOT_ENOUGH_MEMORY);
+		return;
+	}
+	if (!timer_.Start(100)) {
+		Stop();
+		Error(ERROR_NOT_ENOUGH_MEMORY);
+	}
+}
+
+void LocalApi::Stop()
+{
+	timer_.Stop();
+	if (stop_) SetEvent(stop_);
+	if (worker_.joinable()) worker_.join();
+	if (pipe_ != INVALID_HANDLE_VALUE) CloseHandle(pipe_);
+	pipe_ = INVALID_HANDLE_VALUE;
+	for (auto handle : {stop_, done_, io_event_}) {
+		if (handle) CloseHandle(handle);
+	}
+	stop_ = done_ = io_event_ = nullptr;
+	std::lock_guard<std::mutex> lock(mutex_);
+	pending_ = false;
+	request_.clear();
+	response_.clear();
+	status_ = L"Disabled";
+}
+
+bool LocalApi::FinishIo(OVERLAPPED& ov, BOOL immediate, ULONGLONG deadline, DWORD& transferred)
+{
+	if (immediate) return true;
+	if (GetLastError() != ERROR_IO_PENDING) return false;
+	HANDLE events[]{stop_, ov.hEvent};
+	auto now = GetTickCount64();
+	DWORD wait = deadline ? static_cast<DWORD>(deadline > now ? deadline - now : 0) : INFINITE;
+	if (WaitForMultipleObjects(2, events, FALSE, wait) != WAIT_OBJECT_0 + 1) {
+		// Drain completion before the stack OVERLAPPED or its buffer can disappear.
+		CancelIoEx(pipe_, &ov);
+		GetOverlappedResult(pipe_, &ov, &transferred, TRUE);
+		return false;
+	}
+	return GetOverlappedResult(pipe_, &ov, &transferred, FALSE) != FALSE;
+}
+
+bool LocalApi::Io(bool write, char* data, DWORD size, DWORD& transferred, ULONGLONG deadline)
+{
+	OVERLAPPED ov{};
+	ov.hEvent = io_event_;
+	ResetEvent(io_event_);
+	BOOL immediate = write ? WriteFile(pipe_, data, size, &transferred, &ov) : ReadFile(pipe_, data, size, &transferred, &ov);
+	return FinishIo(ov, immediate, deadline, transferred) && transferred != 0;
+}
+
+void LocalApi::Run()
+{
+	try {
+		while (WaitForSingleObject(stop_, 0) == WAIT_TIMEOUT) {
+			OVERLAPPED ov{};
+			ov.hEvent = io_event_;
+			ResetEvent(io_event_);
+			DWORD ignored{};
+			BOOL connected = ConnectNamedPipe(pipe_, &ov);
+			if (!connected && GetLastError() == ERROR_PIPE_CONNECTED) connected = TRUE;
+			if (!FinishIo(ov, connected, 0, ignored)) {
+				if (WaitForSingleObject(stop_, 0) == WAIT_TIMEOUT) Error(GetLastError());
+				break;
+			}
+			std::string input;
+			ULONGLONG read_deadline = GetTickCount64() + timeout_ms;
+			while (WaitForSingleObject(stop_, 0) == WAIT_TIMEOUT) {
+				auto newline = input.find('\n');
+				if ((newline == std::string::npos && input.size() > max_request) || (newline != std::string::npos && newline > max_request)) {
+					break;
+				}
+				if (newline == std::string::npos) {
+					char buffer[4096];
+					DWORD count{};
+					if (!Io(false, buffer, sizeof(buffer), count, read_deadline)) break;
+					input.append(buffer, count);
+					continue;
+				}
+				auto output = Exchange(input.substr(0, newline));
+				input.erase(0, newline + 1);
+				auto write_deadline = GetTickCount64() + timeout_ms;
+				size_t sent{};
+				while (sent < output.size()) {
+					DWORD count{};
+					if (!Io(true, output.data() + sent, static_cast<DWORD>(output.size() - sent), count, write_deadline)) break;
+					sent += count;
+				}
+				if (sent != output.size()) break;
+				read_deadline = GetTickCount64() + timeout_ms;
+			}
+			DisconnectNamedPipe(pipe_);
+		}
+	}
+	catch (...) {
+		Error(ERROR_NOT_ENOUGH_MEMORY);
+	}
+}
+
+std::string LocalApi::Exchange(std::string const& line)
+{
+	if (line.empty() || !MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, line.data(), static_cast<int>(line.size()), nullptr, 0)) {
+		return Encode(ErrorResponse({}, -32700, "Invalid UTF-8 JSON"));
+	}
+	auto request = fz::json::parse(line);
+	if (!request) return Encode(ErrorResponse({}, -32700, "Parse error"));
+	auto const& id = static_cast<fz::json const&>(request)["id"];
+	bool valid_id = !id || id.is_null() || id.type() == fz::json_type::string || id.is_number();
+	if (!request.is_object() || !UniqueMembers(line) || !Members(request, {"jsonrpc", "id", "method", "params"}) ||
+		request["jsonrpc"].type() != fz::json_type::string || request["jsonrpc"].string_value() != "2.0" ||
+		request["method"].type() != fz::json_type::string || !valid_id) {
+		return Encode(ErrorResponse({}, -32600, "Invalid Request"));
+	}
+	bool notification = !id;
+	ResetEvent(done_);
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		request_ = line;
+		response_.clear();
+		deadline_ = GetTickCount64() + timeout_ms;
+		pending_ = true;
+	}
+	HANDLE events[]{stop_, done_};
+	auto result = WaitForMultipleObjects(2, events, FALSE, timeout_ms);
+	std::lock_guard<std::mutex> lock(mutex_);
+	// Tick holds this same lock through dispatch. Expired queued work is removed,
+	// never left in the GUI event queue to execute a refresh after a timeout.
+	pending_ = false;
+	request_.clear();
+	if (notification || result == WAIT_OBJECT_0) return {};
+	if (result != WAIT_OBJECT_0 + 1 && response_.empty()) return Encode(ErrorResponse(id, -32002, "GUI request timed out"));
+	return response_;
+}
+
+void LocalApi::Tick(wxTimerEvent&)
+{
+	std::lock_guard<std::mutex> lock(mutex_);
+	if (!pending_) return;
+	auto request = fz::json::parse(request_);
+	try {
+		if (GetTickCount64() >= deadline_) {
+			response_ = Encode(ErrorResponse(request["id"], -32002, "GUI request timed out"));
+		}
+		else if (!frame_.IsEnabled() || frame_.IsBeingDeleted()) {
+			response_ = Encode(ErrorResponse(request["id"], -32000, "GUI unavailable (modal or shutdown)"));
+		}
+		else {
+			response_ = Encode(Dispatch(request, deadline_));
+		}
+	}
+	catch (...) {
+		response_ = Encode(ErrorResponse(request["id"], -32603, "Internal error"));
+	}
+	pending_ = false;
+	SetEvent(done_);
+}
+
+fz::json LocalApi::Dispatch(fz::json const& request, ULONGLONG deadline)
+{
+	auto const& id = request["id"];
+	auto const& params = request["params"];
+	auto method = request["method"].string_value();
+	if (params && !params.is_object()) return ErrorResponse(id, -32602, "Params must be an object");
+	if ((method == "api.info" || method == "sessions.list" || method == "queue.summary") && params.children()) {
+		return ErrorResponse(id, -32602, "Method takes no params");
+	}
+	if ((method == "sessions.refresh" && !Members(params, {"session"})) ||
+		(method == "sessions.files" && !Members(params, {"session", "offset", "limit"}))) {
+		return ErrorResponse(id, -32602, "Unknown params member");
+	}
+	fz::json result;
+	if (method == "api.info") {
+		result["version"] = "3.71.1";
+		result["protocol"] = "jsonrpc-2.0-ndjson";
+		result["pipe"] = "filezilla-api-" + std::to_string(GetCurrentProcessId());
+		result["max_request_bytes"] = max_request;
+		result["max_response_bytes"] = max_response;
+		result["cache_semantics"] = "Cached snapshots only; stale=true means freshness is not guaranteed. Refresh acceptance is not completion; re-read files later.";
+	}
+	else if (method == "sessions.list") {
+		result["sessions"] = fz::json(fz::json_type::array);
+		size_t index{};
+		for (auto* state : *CContextManager::Get()->GetAllStates()) {
+			if (!IsSession(state)) continue;
+			auto& entry = result["sessions"][index++];
+			auto const& site = state->GetSite();
+			entry["id"] = Id(state);
+			entry["active"] = state == CContextManager::Get()->GetCurrentContext();
+			entry["connected"] = state->IsRemoteConnected();
+			entry["idle"] = state->IsRemoteIdle();
+			entry["protocol"] = site ? CServer::GetPrefixFromProtocol(site.server.GetProtocol()) : std::wstring();
+			entry["host"] = site ? site.server.GetHost() : std::wstring();
+			entry["port"] = site ? site.server.GetPort() : 0u;
+			entry["remote_path"] = state->GetRemotePath().GetPath();
+			entry["local_path"] = state->GetLocalDir().GetPath();
+		}
+	}
+	else if (method == "queue.summary") {
+		auto* queue = frame_.GetQueue();
+		if (!queue) return ErrorResponse(id, -32000, "Queue unavailable");
+		result["active"] = queue->IsActive() != 0;
+		result["file_count"] = queue->GetFileCount();
+	}
+	else if (method == "sessions.files" || method == "sessions.refresh") {
+		if (params["session"].type() != fz::json_type::string) return ErrorResponse(id, -32602, "session must be a string");
+		CState* selected{};
+		for (auto* state : *CContextManager::Get()->GetAllStates()) {
+			if (IsSession(state) && Id(state) == params["session"].string_value()) selected = state;
+		}
+		if (!selected) return ErrorResponse(id, -32602, "Unknown session");
+		result["session"] = Id(selected);
+		if (method == "sessions.refresh") {
+			if (!selected->IsRemoteConnected() || !selected->IsRemoteIdle()) return ErrorResponse(id, -32001, "Session not connected or busy (including recursive operations)");
+			// RefreshRemote can show synchronous dialogs when synchronized browsing
+			// needs a local directory. Never enter a nested modal loop from dispatch.
+			if (selected->GetSyncBrowse()) return ErrorResponse(id, -32001, "Disable synchronized browsing before API refresh");
+			if (GetTickCount64() >= deadline) return ErrorResponse(id, -32002, "Refresh expired before execution");
+			if (!selected->RefreshRemote()) return ErrorResponse(id, -32001, "Refresh not accepted");
+			result["accepted"] = true;
+			result["completed"] = false;
+		}
+		else {
+			int64_t offset{}, limit{100};
+			if ((params["offset"] && !Integer(params["offset"], offset)) || (params["limit"] && !Integer(params["limit"], limit)) || offset < 0 || limit < 1 || limit > 1000) {
+				return ErrorResponse(id, -32602, "offset must be nonnegative; limit must be 1..1000 (integers)");
+			}
+			auto listing = selected->GetRemoteDir();
+			result["path"] = listing ? listing->path.GetPath() : selected->GetRemotePath().GetPath();
+			result["cached"] = true;
+			result["stale"] = true;
+			result["available"] = listing != nullptr;
+			result["failed"] = listing && listing->failed();
+			result["unsure"] = listing && listing->get_unsure_flags() != 0;
+			result["offset"] = offset;
+			result["limit"] = limit;
+			size_t total = listing ? listing->size() : 0;
+			result["total"] = total;
+			result["entries"] = fz::json(fz::json_type::array);
+			size_t start = static_cast<uint64_t>(offset) < total ? static_cast<size_t>(offset) : total;
+			size_t end = start + std::min(static_cast<size_t>(limit), total - start);
+			size_t encoded_size{};
+			for (size_t i = start; i < end; ++i) {
+				auto const& file = (*listing)[i];
+				auto& entry = result["entries"][i - start];
+				entry["path"] = listing->path.FormatFilename(file.name);
+				entry["name"] = file.name;
+				entry["size"] = file.size;
+				entry["type"] = file.is_link() ? "link" : file.is_dir() ? "directory" : "file";
+				entry["permissions"] = *file.permissions;
+				encoded_size += entry.to_string().size();
+				if (encoded_size >= max_response) return ErrorResponse(id, -32003, "Response too large; use a smaller page");
+			}
+			result["next_offset"] = end < total ? fz::json() : fz::json(fz::json_type::null);
+			if (end < total) result["next_offset"] = end;
+		}
+	}
+	else return ErrorResponse(id, -32601, "Method not found");
+	fz::json reply;
+	reply["jsonrpc"] = "2.0";
+	reply["id"] = id ? id : fz::json(fz::json_type::null);
+	reply["result"] = std::move(result);
+	return reply;
+}
+#endif
