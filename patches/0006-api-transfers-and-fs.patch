+fz::json LocalApi::Cwd(fz::json const& id, fz::json const& params)
+{
+	auto const& session = params["session"];
+	if (session.type() != fz::json_type::string) return ErrorResponse(id, -32602, "session must be a string");
+	auto* state = Session(session.string_value());
+	if (!state) return ErrorResponse(id, -32602, "Unknown session");
+	auto const& site = state->GetSite();
+	if (!state->IsRemoteConnected() || !state->IsRemoteIdle(true)) {
+		Audit("sessions.cwd", site.GetName(), {}, "error -32007");
+		return ErrorResponse(id, -32007, "Session not connected or busy");
+	}
+	if (state->GetSyncBrowse()) {
+		Audit("sessions.cwd", site.GetName(), {}, "error -32001");
+		return ErrorResponse(id, -32001, "Disable synchronized browsing before API directory changes");
+	}
+	auto const& siteParam = params["site"];
+	if (siteParam && !siteParam.is_null() && siteParam.type() != fz::json_type::string) return ErrorResponse(id, -32602, "site must be a string");
+	auto requestedSite = siteParam.type() == fz::json_type::string ? FromUtf8(siteParam.string_value()) : std::wstring();
+	if (!SiteNameMatches(requestedSite, site.GetName())) {
+		Audit("sessions.cwd", site.GetName(), {requestedSite}, "error -32004 site mismatch");
+		return ErrorResponse(id, -32004, "Site mismatch");
+	}
+	Roots roots;
+	if (auto rootsError = SiteRoots(site, roots)) {
+		Audit("sessions.cwd", site.GetName(), {}, "error -32004");
+		return ErrorResponse(id, -32004, rootsError);
+	}
+	if (params["path"].type() != fz::json_type::string) return ErrorResponse(id, -32602, "path must be a string");
+	std::wstring requested = FromUtf8(params["path"].string_value());
+	CServerPath target;
+	if (IsAbsoluteRemote(requested)) {
+		if (!ParseRemotePath(requested, site.server.GetType(), target)) {
+			Audit("sessions.cwd", site.GetName(), {requested}, "error -32005");
+			return ErrorResponse(id, -32005, "Invalid remote path");
+		}
+	}
+	else if (!RemotePathFor(roots.remote, requested, true, target)) {
+		Audit("sessions.cwd", site.GetName(), {requested}, "error -32005");
+		return ErrorResponse(id, -32005, "Invalid relative path");
+	}
+	if (!target.IsSubdirOf(roots.remote, false, true)) {
+		Audit("sessions.cwd", site.GetName(), {target.GetPath()}, "error -32004");
+		return ErrorResponse(id, -32004, "Path outside API root");
+	}
+	if (!state->ChangeRemoteDir(target, std::wstring(), 0, false)) {
+		Audit("sessions.cwd", site.GetName(), {target.GetPath()}, "error -32007");
+		return ErrorResponse(id, -32007, "Directory change not accepted");
+	}
+	Audit("sessions.cwd", site.GetName(), {target.GetPath()}, "accepted");
+	fz::json result;
+	result["accepted"] = true;
+	result["path"] = target.GetPath();
+	return Reply(id, std::move(result));
+}
