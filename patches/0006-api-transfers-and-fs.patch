+constexpr ULONGLONG auto_overwrite_ttl_ms = 180 * 1000; // 180 s
+constexpr size_t max_auto_overwrite_entries = 256;
+
+// API transfers go through the normal queue, where the file-exists default can
+// be "ask" and would open a modal dialog. Overwrite is the API default in both
+// directions: a download replaces an existing local file, an upload replaces an
+// existing remote file. Remember recent API transfers briefly so ProcessDefaults
+// can select overwrite without user interaction. The GUI thread owns this
+// registry. Entries are not consumed, so engine retries of the same transfer
+// keep working.
+struct AutoOverwriteEntry
+{
+	bool download{};
+	std::wstring localFile;
+	std::wstring remotePath;
+	std::wstring remoteFile;
+	ULONGLONG expiry{};
+	bool audited{};
+};
+
+std::vector<AutoOverwriteEntry> autoOverwriteEntries;
+
+std::wstring NormalizeLocalForMatch(std::wstring text)
+{
+	for (auto& c : text) {
+		if (c == L'/') {
+			c = L'\\';
+		}
+		c = static_cast<wchar_t>(std::towlower(c));
+	}
+	return text;
+}
+
+void PruneAutoOverwrite(ULONGLONG now)
+{
+	autoOverwriteEntries.erase(std::remove_if(autoOverwriteEntries.begin(), autoOverwriteEntries.end(),
+		[now](AutoOverwriteEntry const& entry) { return now >= entry.expiry; }), autoOverwriteEntries.end());
+}
+
+void RegisterAutoOverwrite(bool download, std::wstring const& localFile, CServerPath const& remotePath, std::wstring const& remoteFile)
+{
+	auto const now = GetTickCount64();
+	PruneAutoOverwrite(now);
+	AutoOverwriteEntry entry;
+	entry.download = download;
+	entry.localFile = NormalizeLocalForMatch(localFile);
+	entry.remotePath = remotePath.GetPath();
+	entry.remoteFile = remoteFile;
+	entry.expiry = now + auto_overwrite_ttl_ms;
+	autoOverwriteEntries.push_back(std::move(entry));
+	while (autoOverwriteEntries.size() > max_auto_overwrite_entries) {
+		autoOverwriteEntries.erase(autoOverwriteEntries.begin());
+	}
+}
+}
+
+// The name is part of the hook contract. Matching deliberately does not remove
+// the entry, so retries of the same transfer are also auto-overwritten.
+bool ApiConsumeAutoOverwrite(bool download, std::wstring const& localFile, CServerPath const& remotePath, std::wstring const& remoteFile)
+{
+	auto const now = GetTickCount64();
+	PruneAutoOverwrite(now);
+	auto const local = NormalizeLocalForMatch(localFile);
+	auto const remote = remotePath.GetPath();
+	for (auto& entry : autoOverwriteEntries) {
+		if (entry.download != download || entry.remotePath != remote || entry.remoteFile != remoteFile) {
+			continue;
+		}
+		if (entry.localFile != local) {
+			continue;
+		}
+		if (!entry.audited) {
+			entry.audited = true;
+			auto line = IsoUtc(std::time(nullptr));
+			line += " method=auto-overwrite";
+			line += (download ? " download=true" : " download=false");
+			line += " remote_file=" + AuditField(remoteFile);
+			line += " local_file=" + AuditField(localFile);
+			line += "\n";
+			AppendAuditLine(line);
+		}
+		return true;
+	}
+	return false;
