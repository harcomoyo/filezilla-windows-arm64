+	}
+	auto now = GetTickCount64();
+	for (auto it = plans_.begin(); it != plans_.end();) {
+		if (now >= it->second.expiry) it = plans_.erase(it);
+		else ++it;
+	}
+	CServerPath current = state->GetRemotePath();
+	auto listing = state->GetRemoteDir();
+	if (!current) {
+		Audit("fs.prepare", site.GetName(), {}, "error -32008");
+		return ErrorResponse(id, -32008, "No current remote directory");
+	}
+	if (!listing || listing->path != current || listing->failed()) {
+		Audit("fs.prepare", site.GetName(), {current.GetPath()}, "error -32008");
+		return ErrorResponse(id, -32008, "Cached listing unavailable");
+	}
+	Plan plan;
+	plan.op = op;
+	plan.session = Id(state);
+	plan.site = site.GetName();
+	plan.expiry = now + 60000;
+	fz::json summary;
+	std::vector<std::wstring> auditPaths;
+	if (op == "mkdir") {
+		if (params["path"].type() != fz::json_type::string) return ErrorResponse(id, -32602, "path must be a string");
+		std::wstring relative = FromUtf8(params["path"].string_value());
+		if (!RelativePath(relative, false)) {
+			Audit("fs.prepare", site.GetName(), {relative}, "error -32005");
+			return ErrorResponse(id, -32005, "path must be a relative POSIX path");
+		}
+		CServerPath remote;
+		if (!RemotePathFor(roots.remote, relative, false, remote)) {
+			Audit("fs.prepare", site.GetName(), {relative}, "error -32004");
+			return ErrorResponse(id, -32004, "Remote path outside API root");
+		}
+		std::wstring name = remote.GetLastSegment();
+		if (name.empty() || remote.GetParent() != current) {
+			Audit("fs.prepare", site.GetName(), {relative, remote.GetPath()}, "error -32008");
+			return ErrorResponse(id, -32008, "Parent directory is not the cached current directory");
+		}
+		if (listing->FindFile_CmpCase(name) != std::string::npos) {
+			Audit("fs.prepare", site.GetName(), {relative, remote.GetPath()}, "error -32005");
+			return ErrorResponse(id, -32005, "Target already exists");
+		}
+		std::wstring local;
+		if (!LocalPathFor(roots.local, relative, false, local)) {
+			Audit("fs.prepare", site.GetName(), {relative}, "error -32004");
+			return ErrorResponse(id, -32004, "Local path outside API root");
+		}
+		plan.path = relative;
+		summary["relative"] = relative;
+		summary["remote"] = remote.GetPath();
+		summary["local"] = local;
+		auditPaths = {relative, remote.GetPath()};
+	}
+	else if (op == "rename") {
+		if (params["from"].type() != fz::json_type::string || params["to"].type() != fz::json_type::string) {
+			return ErrorResponse(id, -32602, "from and to must be strings");
+		}
+		std::wstring fromRelative = FromUtf8(params["from"].string_value());
+		std::wstring toRelative = FromUtf8(params["to"].string_value());
+		if (!RelativePath(fromRelative, false) || !RelativePath(toRelative, false)) {
+			Audit("fs.prepare", site.GetName(), {fromRelative, toRelative}, "error -32005");
+			return ErrorResponse(id, -32005, "from and to must be relative POSIX paths");
+		}
+		CServerPath from, to;
+		if (!RemotePathFor(roots.remote, fromRelative, false, from) || !RemotePathFor(roots.remote, toRelative, false, to)) {
+			Audit("fs.prepare", site.GetName(), {fromRelative, toRelative}, "error -32004");
+			return ErrorResponse(id, -32004, "Remote path outside API root");
+		}
+		std::wstring fromName = from.GetLastSegment();
+		std::wstring toName = to.GetLastSegment();
+		if (fromName.empty() || toName.empty() || from.GetParent() != to.GetParent()) {
+			Audit("fs.prepare", site.GetName(), {fromRelative, toRelative}, "error -32005");
+			return ErrorResponse(id, -32005, "Invalid rename paths");
+		}
+		if (from.GetParent() != current) {
+			Audit("fs.prepare", site.GetName(), {fromRelative, from.GetPath()}, "error -32008");
+			return ErrorResponse(id, -32008, "Parent directory is not the cached current directory");
+		}
+		if (listing->FindFile_CmpCase(fromName) == std::string::npos) {
+			Audit("fs.prepare", site.GetName(), {fromRelative, from.GetPath()}, "error -32008");
+			return ErrorResponse(id, -32008, "Source not found");
+		}
+		if (listing->FindFile_CmpCase(toName) != std::string::npos) {
+			Audit("fs.prepare", site.GetName(), {toRelative, to.GetPath()}, "error -32005");
+			return ErrorResponse(id, -32005, "Target already exists");
+		}
+		std::wstring fromLocal, toLocal;
+		if (!LocalPathFor(roots.local, fromRelative, false, fromLocal) || !LocalPathFor(roots.local, toRelative, false, toLocal)) {
+			Audit("fs.prepare", site.GetName(), {fromRelative, toRelative}, "error -32004");
+			return ErrorResponse(id, -32004, "Local path outside API root");
+		}
+		plan.from = fromRelative;
+		plan.to = toRelative;
+		summary["from_relative"] = fromRelative;
+		summary["to_relative"] = toRelative;
+		summary["from_remote"] = from.GetPath();
+		summary["to_remote"] = to.GetPath();
+		summary["from_local"] = fromLocal;
+		summary["to_local"] = toLocal;
+		auditPaths = {fromRelative, from.GetPath(), toRelative, to.GetPath()};
+	}
+	else {
+		if (params["path"].type() != fz::json_type::string) return ErrorResponse(id, -32602, "path must be a string");
+		std::wstring relative = FromUtf8(params["path"].string_value());
+		if (!RelativePath(relative, false)) {
+			Audit("fs.prepare", site.GetName(), {relative}, "error -32005");
+			return ErrorResponse(id, -32005, "path must be a relative POSIX path");
+		}
+		CServerPath remote;
+		if (!RemotePathFor(roots.remote, relative, false, remote)) {
+			Audit("fs.prepare", site.GetName(), {relative}, "error -32004");
+			return ErrorResponse(id, -32004, "Remote path outside API root");
+		}
+		std::wstring name = remote.GetLastSegment();
+		if (name.empty() || remote.GetParent() != current) {
+			Audit("fs.prepare", site.GetName(), {relative, remote.GetPath()}, "error -32008");
+			return ErrorResponse(id, -32008, "Parent directory is not the cached current directory");
+		}
+		size_t found = listing->FindFile_CmpCase(name);
+		if (found == std::string::npos) {
+			Audit("fs.prepare", site.GetName(), {relative, remote.GetPath()}, "error -32008");
+			return ErrorResponse(id, -32008, "File not found");
+		}
+		if ((*listing)[found].is_dir()) {
+			Audit("fs.prepare", site.GetName(), {relative, remote.GetPath()}, "error -32009");
+			return ErrorResponse(id, -32009, "Directory deletion is not supported in this phase");
+		}
+		std::wstring local;
+		if (!LocalPathFor(roots.local, relative, false, local)) {
+			Audit("fs.prepare", site.GetName(), {relative}, "error -32004");
+			return ErrorResponse(id, -32004, "Local path outside API root");
+		}
+		plan.path = relative;
+		summary["relative"] = relative;
+		summary["remote"] = remote.GetPath();
+		summary["local"] = local;
+		auditPaths = {relative, remote.GetPath()};
+	}
+	auto planId = "p-" + std::to_string(++next_plan_);
+	plans_[planId] = std::move(plan);
+	Audit("fs.prepare", site.GetName(), auditPaths, "prepared");
+	fz::json result;
+	result["plan_id"] = planId;
+	result["op"] = op;
+	result["summary"] = std::move(summary);
+	result["expires_at"] = IsoUtc(std::time(nullptr) + 60);
+	return Reply(id, std::move(result));
+}
+
+fz::json LocalApi::Commit(fz::json const& id, fz::json const& params)
+{
+	if (params["plan_id"].type() != fz::json_type::string) return ErrorResponse(id, -32602, "plan_id must be a string");
+	auto planId = params["plan_id"].string_value();
+	auto now = GetTickCount64();
+	for (auto it = plans_.begin(); it != plans_.end();) {
+		if (now >= it->second.expiry) it = plans_.erase(it);
+		else ++it;
+	}
+	auto found = plans_.find(planId);
+	if (found == plans_.end()) return ErrorResponse(id, -32006, "Unknown or expired plan");
+	Plan plan = std::move(found->second);
+	auto* state = Session(plan.session);
+	if (!state) {
+		plans_.erase(found);
+		return ErrorResponse(id, -32006, "Plan session is no longer available");
+	}
+	auto const& site = state->GetSite();
+	if (!state->IsRemoteConnected() || !state->IsRemoteIdle()) {
+		return ErrorResponse(id, -32007, "Session not connected or busy");
+	}
+	if (!SiteNameMatches(plan.site, site.GetName())) {
+		plans_.erase(found);
+		Audit("fs.commit", site.GetName(), {plan.site}, "error -32004 site mismatch");
+		return ErrorResponse(id, -32004, "Site mismatch");
+	}
+	Roots roots;
+	if (auto rootsError = SiteRoots(site, roots)) return ErrorResponse(id, -32004, rootsError);
+	CServerPath remote, from, to;
+	std::wstring localFrom, localTo;
+	if (plan.op == "mkdir" || plan.op == "delete") {
+		if (!RelativePath(plan.path, false) || !RemotePathFor(roots.remote, plan.path, false, remote) ||
+			!LocalPathFor(roots.local, plan.path, false, localFrom)) {
+			return ErrorResponse(id, -32004, "Plan path is outside API roots");
+		}
+	}
+	else {
+		if (!RelativePath(plan.from, false) || !RelativePath(plan.to, false) ||
+			!RemotePathFor(roots.remote, plan.from, false, from) || !RemotePathFor(roots.remote, plan.to, false, to) ||
+			!LocalPathFor(roots.local, plan.from, false, localFrom) || !LocalPathFor(roots.local, plan.to, false, localTo) ||
+			from.GetParent() != to.GetParent()) {
+			return ErrorResponse(id, -32004, "Plan path is outside API roots");
+		}
+	}
+	plans_.erase(found);
+	if (!state->m_pCommandQueue) return ErrorResponse(id, -32007, "Session command queue unavailable");
+	fz::json result;
+	result["executed"] = true;
+	result["op"] = plan.op;
+	if (plan.op == "mkdir") {
+		state->m_pCommandQueue->ProcessCommand(new CMkdirCommand(remote, transfer_flags::none));
+		result["relative"] = plan.path;
+		result["remote"] = remote.GetPath();
+		Audit("fs.commit", site.GetName(), {plan.path, remote.GetPath()}, "executed mkdir");
+	}
+	else if (plan.op == "rename") {
+		CServerPath parent = from.GetParent();
+		state->m_pCommandQueue->ProcessCommand(new CRenameCommand(parent, from.GetLastSegment(), parent, to.GetLastSegment()));
+		result["from_relative"] = plan.from;
+		result["to_relative"] = plan.to;
+		result["from_remote"] = from.GetPath();
+		result["to_remote"] = to.GetPath();
+		Audit("fs.commit", site.GetName(), {plan.from, from.GetPath(), plan.to, to.GetPath()}, "executed rename");
+	}
+	else {
+		CServerPath parent = remote.GetParent();
+		state->m_pCommandQueue->ProcessCommand(new CDeleteCommand(parent, std::vector<std::wstring>{remote.GetLastSegment()}));
+		result["relative"] = plan.path;
+		result["remote"] = remote.GetPath();
+		Audit("fs.commit", site.GetName(), {plan.path, remote.GetPath()}, "executed delete");
+	}
+	return Reply(id, std::move(result));
+}
 #endif
