+fz::json LocalApi::JobStatus(fz::json const& id, fz::json const& params)
+{
+	auto const& wanted = params["job"];
+	if (wanted && wanted.type() != fz::json_type::string) return ErrorResponse(id, -32602, "job must be a string");
+	std::string filter;
+	bool haveFilter{};
+	if (wanted) {
+		filter = wanted.string_value();
+		haveFilter = true;
+		bool found{};
+		for (auto const& job : jobs_) {
+			if (job.id == filter) found = true;
+		}
+		if (!found) return ErrorResponse(id, -32008, "Unknown job");
+	}
+	fz::json result;
+	result["jobs"] = fz::json(fz::json_type::array);
+	size_t index{};
+	for (auto const& job : jobs_) {
+		if (haveFilter && job.id != filter) continue;
+		auto& entry = result["jobs"][index++];
+		entry["id"] = job.id;
+		entry["kind"] = job.kind;
+		entry["created_utc"] = job.created_utc;
+	}
+	auto* queue = frame_.GetQueue();
+	if (!queue) return ErrorResponse(id, -32000, "Queue unavailable");
+	result["queue"]["active"] = queue->IsActive() != 0;
+	result["queue"]["file_count"] = queue->GetFileCount();
+	return Reply(id, std::move(result));
+}
