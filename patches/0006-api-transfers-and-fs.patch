+
+bool ReadUtf8File(std::wstring const& path, std::string& text)
+{
+	HANDLE file = CreateFileW(path.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+		nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+	if (file == INVALID_HANDLE_VALUE) {
+		return false;
+	}
+	LARGE_INTEGER size{};
+	bool ok = GetFileSizeEx(file, &size) != FALSE && size.QuadPart >= 0 && size.QuadPart <= 64 * 1024;
+	if (ok) {
+		text.resize(static_cast<size_t>(size.QuadPart));
+		size_t offset{};
+		while (offset < text.size()) {
+			DWORD count{};
+			if (!ReadFile(file, text.data() + offset, static_cast<DWORD>(text.size() - offset), &count, nullptr) || !count) {
+				ok = false;
+				break;
+			}
+			offset += count;
+		}
+	}
+	CloseHandle(file);
+	if (!ok) {
+		return false;
+	}
+	if (text.size() >= 3 && static_cast<unsigned char>(text[0]) == 0xef && static_cast<unsigned char>(text[1]) == 0xbb && static_cast<unsigned char>(text[2]) == 0xbf) {
+		text.erase(0, 3);
+	}
+	return true;
+}
+
+bool HasControlChars(std::wstring const& text)
+{
+	for (wchar_t c : text) {
+		if (c < 0x20 || c == 0x7f) {
+			return true;
+		}
+	}
+	return false;
+}
+
+bool HasParentSegment(std::wstring const& text)
+{
+	size_t start{};
+	while (start <= text.size()) {
+		auto pos = text.find_first_of(L"/\\", start);
+		auto segment = text.substr(start, pos == std::wstring::npos ? std::wstring::npos : pos - start);
+		if (segment == L"..") {
+			return true;
+		}
+		if (pos == std::wstring::npos) {
+			break;
+		}
+		start = pos + 1;
+	}
+	return false;
+}
+
+bool IsAbsoluteRemote(std::wstring const& text)
+{
+	if (text.empty()) {
+		return false;
+	}
+	if (text[0] == L'/' || text[0] == L'\\' || text[0] == L'[') {
+		return true;
+	}
+	return text.size() >= 3 && std::iswalpha(text[0]) && text[1] == L':' && (text[2] == L'/' || text[2] == L'\\');
+}
+
+bool HasTrailingSeparator(std::wstring const& text)
+{
+	return !text.empty() && (text.back() == L'/' || text.back() == L'\\');
+}
+
+bool BareRemoteName(std::wstring const& name)
+{
+	if (name.empty() || name == L"." || name == L".." || HasControlChars(name)) {
+		return false;
+	}
+	return name.find_first_of(L"/\\") == std::wstring::npos;
+}
+
+bool EqualNoCase(std::wstring const& left, std::wstring const& right)
+{
+	if (left.size() != right.size()) {
+		return false;
+	}
+	for (size_t i{}; i < left.size(); ++i) {
+		if (std::towlower(left[i]) != std::towlower(right[i])) {
+			return false;
+		}
+	}
+	return true;
+}
+
+bool BareLocalName(std::wstring const& name)
+{
+	if (!BareRemoteName(name) || name.back() == L' ' || name.back() == L'.') {
+		return false;
+	}
+	if (name.find_first_of(L"<>:\"|?*") != std::wstring::npos) {
+		return false;
+	}
+	auto dot = name.find(L'.');
+	auto base = name.substr(0, dot);
+	for (auto const* reserved : {L"CON", L"PRN", L"AUX", L"NUL", L"COM1", L"COM2", L"COM3", L"COM4", L"COM5", L"COM6", L"COM7", L"COM8", L"COM9", L"LPT1", L"LPT2", L"LPT3", L"LPT4", L"LPT5", L"LPT6", L"LPT7", L"LPT8", L"LPT9"}) {
+		if (EqualNoCase(base, reserved)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+bool IsAbsoluteLocal(std::wstring const& text)
+{
+	if (text.size() >= 2 && text[0] == L'\\' && text[1] == L'\\') {
+		return true;
+	}
+	return text.size() >= 3 && std::iswalpha(text[0]) && text[1] == L':' && (text[2] == L'/' || text[2] == L'\\');
+}
+
+bool RelativePath(std::wstring const& text, bool allowEmpty)
+{
+	if (text.empty()) {
+		return allowEmpty;
+	}
+	if (HasControlChars(text) || text[0] == L'/' || text.find(L'\\') != std::wstring::npos) {
+		return false;
+	}
+	if (text.size() >= 2 && std::iswalpha(text[0]) && text[1] == L':') {
+		return false;
+	}
+	size_t start{};
+	while (true) {
+		auto pos = text.find(L'/', start);
+		auto segment = text.substr(start, pos == std::wstring::npos ? std::wstring::npos : pos - start);
+		if (segment.empty() || segment == L"." || segment == L"..") {
+			return false;
+		}
+		if (pos == std::wstring::npos) {
+			break;
+		}
+		start = pos + 1;
+	}
+	return true;
+}
+
+bool LocalRelativePath(std::wstring const& text, bool allowEmpty)
+{
+	if (!RelativePath(text, allowEmpty)) {
+		return false;
+	}
+	size_t start{};
+	while (start < text.size()) {
+		auto pos = text.find(L'/', start);
+		auto segment = text.substr(start, pos == std::wstring::npos ? std::wstring::npos : pos - start);
+		if (!BareLocalName(segment)) {
+			return false;
+		}
+		if (pos == std::wstring::npos) {
+			break;
+		}
+		start = pos + 1;
+	}
+	return true;
+}
+
+std::wstring TrimLocalRoot(std::wstring path)
+{
+	while (path.size() > 3 && (path.back() == L'\\' || path.back() == L'/')) {
+		path.pop_back();
+	}
+	return path;
+}
+
+bool ParseRemotePath(std::wstring const& text, ServerType type, CServerPath& path)
+{
+	if (text.size() > 4096 || HasControlChars(text) || HasParentSegment(text) || !IsAbsoluteRemote(text)) {
+		return false;
+	}
+	CServerPath parsed(text, type);
+	if (!parsed) {
+		return false;
+	}
+	path = std::move(parsed);
+	return true;
+}
+
+std::wstring CanonicalLocal(std::wstring const& path)
+{
+	DWORD size = GetFullPathNameW(path.c_str(), 0, nullptr, nullptr);
+	if (!size) {
+		return {};
+	}
+	std::vector<wchar_t> buffer(size + 1);
+	DWORD written = GetFullPathNameW(path.c_str(), size + 1, buffer.data(), nullptr);
+	if (!written || written >= buffer.size()) {
+		return {};
+	}
+	return std::wstring(buffer.data(), written);
+}
+
+bool IsLocalInside(std::wstring child, std::wstring parent)
+{
+	for (auto& c : child) {
+		if (c == L'/') c = L'\\';
+	}
+	for (auto& c : parent) {
+		if (c == L'/') c = L'\\';
+	}
+	while (child.size() > 3 && child.back() == L'\\') child.pop_back();
+	while (parent.size() > 3 && parent.back() == L'\\') parent.pop_back();
+	if (parent.empty() || child.size() < parent.size()) {
+		return false;
+	}
+	for (size_t i{}; i < parent.size(); ++i) {
+		if (std::towlower(child[i]) != std::towlower(parent[i])) {
+			return false;
+		}
+	}
+	return child.size() == parent.size() || parent.back() == L'\\' || child[parent.size()] == L'\\';
+}
+
+// Checks one path component without following a reparse point. Returns false when
+// the component does not exist, so callers can stop at the nearest existing
+// ancestor. An entry that exists but cannot be inspected is treated as unsafe.
+bool ReparsePointAt(std::wstring const& path, bool& reparse)
+{
+	reparse = false;
+	HANDLE handle = CreateFileW(path.c_str(), FILE_READ_ATTRIBUTES,
+		FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
+		FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+	if (handle != INVALID_HANDLE_VALUE) {
+		FILE_ATTRIBUTE_TAG_INFO info{};
+		bool const inspected = GetFileInformationByHandleEx(handle, FileAttributeTagInfo, &info, sizeof(info)) != FALSE;
+		CloseHandle(handle);
+		if (inspected) {
+			reparse = (info.FileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0;
+			return true;
+		}
+	}
+	else {
+		DWORD const error = GetLastError();
+		if (error == ERROR_FILE_NOT_FOUND || error == ERROR_PATH_NOT_FOUND) {
+			return false;
+		}
+	}
+	DWORD const attributes = GetFileAttributesW(path.c_str());
+	if (attributes == INVALID_FILE_ATTRIBUTES) {
+		DWORD const error = GetLastError();
+		if (error == ERROR_FILE_NOT_FOUND || error == ERROR_PATH_NOT_FOUND) {
+			return false;
+		}
+		reparse = true;
+		return true;
+	}
+	reparse = (attributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0;
+	return true;
+}
+
+// Walks every path component below root without following reparse points, stopping
+// at the nearest existing ancestor. Returns true when a component in that chain is
+// a reparse point or when the path cannot be validated.
+bool LocalChainHasReparsePoint(std::wstring const& path, std::wstring const& root)
+{
+	std::wstring resolved = CanonicalLocal(path);
+	std::wstring canonicalRoot = CanonicalLocal(root);
+	if (resolved.empty() || canonicalRoot.empty() || !IsLocalInside(resolved, canonicalRoot)) {
+		return true;
+	}
+	for (auto& c : resolved) {
+		if (c == L'/') c = L'\\';
+	}
+	for (auto& c : canonicalRoot) {
+		if (c == L'/') c = L'\\';
+	}
+	while (resolved.size() > 3 && resolved.back() == L'\\') resolved.pop_back();
+	while (canonicalRoot.size() > 3 && canonicalRoot.back() == L'\\') canonicalRoot.pop_back();
+	size_t offset = canonicalRoot.size();
+	if (offset < resolved.size() && resolved[offset] == L'\\') {
+		++offset;
+	}
+	while (offset < resolved.size()) {
+		auto separator = resolved.find(L'\\', offset);
+		auto end = separator == std::wstring::npos ? resolved.size() : separator;
+		bool reparse{};
+		if (!ReparsePointAt(resolved.substr(0, end), reparse) || reparse) {
+			return reparse;
+		}
+		if (separator == std::wstring::npos) {
+			break;
+		}
+		offset = separator + 1;
+	}
+	return false;
+}
+
+bool LocalFileInfo(std::wstring const& path, bool& directory, uint64_t& size)
+{
+	WIN32_FILE_ATTRIBUTE_DATA data{};
+	if (!GetFileAttributesExW(path.c_str(), GetFileExInfoStandard, &data)) {
+		return false;
+	}
+	directory = (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
+	size = (static_cast<uint64_t>(data.nFileSizeHigh) << 32) | data.nFileSizeLow;
+	return true;
+}
+
+bool EnsureLocalDir(std::wstring const& path, std::wstring const& root, bool& reparse)
+{
+	reparse = false;
+	// Only create subdirectories below the already validated mirror root.
+	DWORD const rootAttributes = GetFileAttributesW(root.c_str());
+	if (rootAttributes == INVALID_FILE_ATTRIBUTES || (rootAttributes & FILE_ATTRIBUTE_DIRECTORY) == 0) {
+		return false;
+	}
+	wxFileName::Mkdir(path, 0777, wxPATH_MKDIR_FULL);
+	DWORD attributes = GetFileAttributesW(path.c_str());
+	if (attributes == INVALID_FILE_ATTRIBUTES || (attributes & FILE_ATTRIBUTE_DIRECTORY) == 0) {
+		return false;
+	}
+	reparse = LocalChainHasReparsePoint(path, root);
+	return !reparse;
+}
+
+bool RemotePathFor(CServerPath const& root, std::wstring const& relative, bool allowEmpty, CServerPath& path)
+{
+	if (!RelativePath(relative, allowEmpty)) {
+		return false;
+	}
+	CServerPath joined = root;
+	if (!relative.empty() && !joined.ChangePath(relative)) {
+		return false;
+	}
+	if (!joined || !joined.IsSubdirOf(root, false, true)) {
+		return false;
+	}
+	path = std::move(joined);
+	return true;
+}
+
+bool LocalPathFor(std::wstring const& root, std::wstring const& relative, bool allowEmpty, std::wstring& path)
+{
+	if (!RelativePath(relative, allowEmpty)) {
+		return false;
+	}
+	std::wstring joined = root;
+	if (!relative.empty()) {
+		if (joined.empty() || joined.back() != L'\\') {
+			joined += L'\\';
+		}
+		for (wchar_t c : relative) {
+			joined += (c == L'/' ? L'\\' : c);
+		}
+	}
+	auto canonical = CanonicalLocal(joined);
+	if (canonical.empty() || !IsLocalInside(canonical, root)) {
+		return false;
+	}
+	path = std::move(canonical);
+	return true;
+}
+
+struct Roots
+{
+	CServerPath remote;
+	std::wstring local;
+};
+
+// Returns nullptr on success. The local mirror root must already exist; API
+// calls only create subdirectories below it.
+char const* SiteRoots(Site const& site, Roots& roots)
+{
+	auto name = site.GetName();
+	if (name.empty()) {
+		return "Site has no API roots";
+	}
+	auto appdata = EnvValue(L"APPDATA");
+	std::string text;
+	if (appdata.empty() || !ReadUtf8File(appdata + L"\\FileZilla\\api-roots.json", text)) {
+		return "Site has no API roots";
+	}
+	auto document = fz::json::parse(text);
+	if (!document || !document.is_object()) {
+		return "Site has no API roots";
+	}
+	auto const& rootsJson = document;
+	auto find = [&rootsJson](std::string const& key, fz::json& entry) {
+		entry = rootsJson[key];
+		return entry && entry.type() != fz::json_type::none;
+	};
+	fz::json entry;
+	bool found = find(ToUtf8(name), entry);
+	if (!found && name.size() > 4 && name.compare(name.size() - 4, 4, L".xml") == 0) {
+		found = find(ToUtf8(name.substr(0, name.size() - 4)), entry);
+	}
+	if (!found || !entry.is_object()) {
+		return "Site has no API roots";
+	}
+	auto const& remoteNode = entry["remote"];
+	auto const& localNode = entry["local"];
+	if (remoteNode.type() != fz::json_type::string || localNode.type() != fz::json_type::string) {
+		return "Site has no API roots";
+	}
+	auto remoteText = FromUtf8(remoteNode.string_value());
+	auto localText = FromUtf8(localNode.string_value());
+	if (remoteText.empty() || localText.empty() || HasControlChars(remoteText) || HasControlChars(localText) || !IsAbsoluteLocal(localText)) {
+		return "Site has no API roots";
+	}
+	CServerPath remote;
+	if (!ParseRemotePath(remoteText, site.server.GetType(), remote)) {
+		return "Site has no API roots";
+	}
+	auto local = TrimLocalRoot(CanonicalLocal(localText));
+	if (local.empty()) {
+		return "Site has no API roots";
+	}
+	DWORD const attributes = GetFileAttributesW(local.c_str());
+	if (attributes == INVALID_FILE_ATTRIBUTES || (attributes & FILE_ATTRIBUTE_DIRECTORY) == 0) {
+		return "Local mirror root missing";
+	}
+	roots.remote = std::move(remote);
+	roots.local = std::move(local);
+	return {};
+}
+
+// A request may name the session's site exactly, or without the ".xml" suffix
+// that SiteRoots also accepts.
+bool SiteNameMatches(std::wstring const& requested, std::wstring const& current)
+{
+	if (requested.empty()) {
+		return false;
+	}
+	if (requested == current) {
+		return true;
+	}
+	return current.size() > 4 && current.compare(current.size() - 4, 4, L".xml") == 0 && requested == current.substr(0, current.size() - 4);
+}
+
+std::string AuditField(std::wstring const& text)
+{
+	auto result = ToUtf8(text);
+	for (auto& c : result) {
+		if (c == '\r' || c == '\n' || (static_cast<unsigned char>(c) < 0x20)) {
+			c = ' ';
+		}
+	}
+	if (result.size() > 512) {
+		result.resize(512);
+	}
+	return result;
+}
+
+void AppendAuditLine(std::string const& line)
+{
+	auto local = EnvValue(L"LOCALAPPDATA");
+	if (local.empty()) {
+		return;
+	}
+	auto directory = local + L"\\FileZilla";
+	CreateDirectoryW(directory.c_str(), nullptr);
+	auto path = directory + L"\\api-audit.log";
+	HANDLE file = CreateFileW(path.c_str(), FILE_APPEND_DATA, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+		nullptr, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+	if (file == INVALID_HANDLE_VALUE) {
+		return;
+	}
+	DWORD written{};
+	WriteFile(file, line.data(), static_cast<DWORD>(line.size()), &written, nullptr);
+	CloseHandle(file);
+}
