+fz::json LocalApi::Download(fz::json const& id, fz::json const& params)
+{
+	auto const& session = params["session"];
+	if (session.type() != fz::json_type::string) return ErrorResponse(id, -32602, "session must be a string");
+	auto* state = Session(session.string_value());
+	if (!state) return ErrorResponse(id, -32602, "Unknown session");
+	auto const& site = state->GetSite();
+	if (!state->IsRemoteConnected() || !state->IsRemoteIdle()) {
+		Audit("transfers.download", site.GetName(), {}, "error -32007");
+		return ErrorResponse(id, -32007, "Session not connected or busy");
+	}
+	auto const& siteParam = params["site"];
+	if (siteParam && !siteParam.is_null() && siteParam.type() != fz::json_type::string) return ErrorResponse(id, -32602, "site must be a string");
+	auto requestedSite = siteParam.type() == fz::json_type::string ? FromUtf8(siteParam.string_value()) : std::wstring();
+	if (!SiteNameMatches(requestedSite, site.GetName())) {
+		Audit("transfers.download", site.GetName(), {requestedSite}, "error -32004 site mismatch");
+		return ErrorResponse(id, -32004, "Site mismatch");
+	}
+	Roots roots;
+	if (auto rootsError = SiteRoots(site, roots)) {
+		Audit("transfers.download", site.GetName(), {}, "error -32004");
+		return ErrorResponse(id, -32004, rootsError);
+	}
+	if (params["path"].type() != fz::json_type::string) return ErrorResponse(id, -32602, "path must be a string");
+	std::wstring relative = FromUtf8(params["path"].string_value());
+	if (!RelativePath(relative, false)) {
+		Audit("transfers.download", site.GetName(), {relative}, "error -32005");
+		return ErrorResponse(id, -32005, "path must be a relative POSIX path");
+	}
+	CServerPath remote;
+	if (!RemotePathFor(roots.remote, relative, false, remote)) {
+		Audit("transfers.download", site.GetName(), {relative}, "error -32004");
+		return ErrorResponse(id, -32004, "Remote path outside API root");
+	}
+	std::wstring remoteName = remote.GetLastSegment();
+	CServerPath remoteParent = remote.GetParent();
+	if (remoteName.empty() || !BareRemoteName(remoteName) || !remoteParent) {
+		Audit("transfers.download", site.GetName(), {relative, remote.GetPath()}, "error -32005");
+		return ErrorResponse(id, -32005, "Invalid remote file path");
+	}
+	CServerPath current = state->GetRemotePath();
+	if (!current) {
+		Audit("transfers.download", site.GetName(), {relative}, "error -32008");
+		return ErrorResponse(id, -32008, "No current remote directory");
+	}
+	if (remoteParent != current) {
+		Audit("transfers.download", site.GetName(), {relative, remote.GetPath()}, "error -32008");
+		return ErrorResponse(id, -32008, "Remote parent is not the current cached directory");
+	}
+	auto listing = state->GetRemoteDir();
+	if (!listing || listing->path != current || listing->failed()) {
+		Audit("transfers.download", site.GetName(), {relative, current.GetPath()}, "error -32008");
+		return ErrorResponse(id, -32008, "Cached listing unavailable");
+	}
+	size_t found = listing->FindFile_CmpCase(remoteName);
+	if (found == std::string::npos) {
+		Audit("transfers.download", site.GetName(), {relative, remote.GetPath()}, "error -32008");
+		return ErrorResponse(id, -32008, "Remote file not found");
+	}
+	auto const& entry = (*listing)[found];
+	if (entry.is_dir()) {
+		Audit("transfers.download", site.GetName(), {relative, remote.GetPath()}, "error -32009");
+		return ErrorResponse(id, -32009, "Directory download is not supported");
+	}
+	if (entry.size < 0) {
+		Audit("transfers.download", site.GetName(), {relative, remote.GetPath()}, "error -32007");
+		return ErrorResponse(id, -32007, "Remote size unknown; refusing transfer");
+	}
+	if (static_cast<uint64_t>(entry.size) > max_transfer_size) {
+		Audit("transfers.download", site.GetName(), {relative, remote.GetPath()}, "error -32007");
+		return ErrorResponse(id, -32007, "File exceeds 100 MiB");
+	}
+	std::wstring localRelative = relative;
+	auto const& localPathNode = params["local_path"];
+	if (localPathNode && localPathNode.type() != fz::json_type::string) return ErrorResponse(id, -32602, "local_path must be a string");
+	if (localPathNode) localRelative = FromUtf8(localPathNode.string_value());
+	if (!LocalRelativePath(localRelative, false)) {
+		Audit("transfers.download", site.GetName(), {relative, localRelative}, "error -32005");
+		return ErrorResponse(id, -32005, "local_path must be a relative POSIX path");
+	}
+	std::wstring localTarget;
+	if (!LocalPathFor(roots.local, localRelative, false, localTarget)) {
+		Audit("transfers.download", site.GetName(), {relative, localRelative}, "error -32004");
+		return ErrorResponse(id, -32004, "Local path outside API root");
+	}
+	if (LocalChainHasReparsePoint(localTarget, roots.local)) {
+		Audit("transfers.download", site.GetName(), {relative, localTarget}, "error -32005");
+		return ErrorResponse(id, -32005, "Reparse point in local path");
+	}
+	std::wstring localName;
+	CLocalPath localDir(localTarget, &localName);
+	if (!localDir || localName.empty()) {
+		Audit("transfers.download", site.GetName(), {localTarget}, "error -32005");
+		return ErrorResponse(id, -32005, "Invalid local target path");
+	}
+	bool reparse{};
+	if (!EnsureLocalDir(localDir.GetPath(), roots.local, reparse)) {
+		Audit("transfers.download", site.GetName(), {localTarget}, "error -32005");
+		return ErrorResponse(id, -32005, reparse ? "Reparse point in local path" : "Cannot create local directory");
+	}
+	auto* queue = frame_.GetQueue();
+	if (!queue) return ErrorResponse(id, -32000, "Queue unavailable");
+	RegisterAutoOverwrite(true, localTarget, remoteParent, remoteName);
+	queue->QueueFile(false, true, remoteName, localName, localDir, current, site, entry.size);
+	queue->QueueFile_Finish(true);
+	Job job;
+	job.id = "j-" + std::to_string(++next_job_);
+	job.kind = "download";
+	job.created_utc = IsoUtc(std::time(nullptr));
+	job.session = Id(state);
+	job.local_path = localTarget;
+	job.remote_path = remote.GetPath();
+	jobs_.push_back(std::move(job));
+	if (jobs_.size() > 100) jobs_.erase(jobs_.begin());
+	Audit("transfers.download", site.GetName(), {relative, remote.GetPath(), localTarget}, "accepted " + jobs_.back().id);
+	fz::json result;
+	result["job"] = jobs_.back().id;
+	result["accepted"] = true;
+	result["local_path"] = jobs_.back().local_path;
+	result["remote_path"] = jobs_.back().remote_path;
+	return Reply(id, std::move(result));
+}
