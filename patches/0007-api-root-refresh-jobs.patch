+
+std::string LocalApi::Fingerprint(CState* state, RefreshSession const& session) const
+{
+	auto listing = state->GetRemoteDir();
+	auto pointer = static_cast<unsigned long long>(reinterpret_cast<uintptr_t>(listing.get()));
+	auto count = static_cast<unsigned long long>(listing ? listing->size() : 0);
+	return std::to_string(session.generation) + ":" + std::to_string(pointer) + ":" + std::to_string(count);
+}
