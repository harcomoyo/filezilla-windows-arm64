+void LocalApi::PruneRefresh(RefreshSession& session, ULONGLONG now)
+{
+	session.tokens.erase(std::remove_if(session.tokens.begin(), session.tokens.end(),
+		[now](RefreshToken const& token) { return now >= token.expires; }), session.tokens.end());
