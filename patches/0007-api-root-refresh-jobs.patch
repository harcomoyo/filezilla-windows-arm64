+// Queue hooks. They are called from the GUI thread and only update the bounded
+// registry above; they never wait for the engine, the queue, or the filesystem.
+void ApiNotifyTransferQueued(bool download, std::wstring const& localFile, CServerPath const& remotePath, std::wstring const& remoteFile)
+{
+	auto const now = GetTickCount64();
+	PruneApiTransfers(now);
+	if (auto* entry = FindTransfer(download, localFile, remotePath, remoteFile)) {
+		if (entry->state != "done" && entry->state != "failed") {
+			entry->state = "queued";
+		}
+	}
+}
+
+void ApiNotifyTransferActive(bool download, std::wstring const& localFile, CServerPath const& remotePath, std::wstring const& remoteFile)
+{
+	auto const now = GetTickCount64();
+	PruneApiTransfers(now);
+	if (auto* entry = FindTransfer(download, localFile, remotePath, remoteFile)) {
+		if (entry->state != "done" && entry->state != "failed") {
+			entry->state = "active";
+		}
+	}
+}
+
+void ApiNotifyTransferProgress(bool download, std::wstring const& localFile, CServerPath const& remotePath, std::wstring const& remoteFile, int64_t transferred)
+{
+	auto const now = GetTickCount64();
+	PruneApiTransfers(now);
+	if (auto* entry = FindTransfer(download, localFile, remotePath, remoteFile)) {
+		if (entry->state != "done" && entry->state != "failed" && transferred >= 0) {
+			entry->transferred_bytes = transferred;
+		}
+	}
+}
+
+void ApiNotifyTransferResult(bool download, std::wstring const& localFile, CServerPath const& remotePath, std::wstring const& remoteFile, bool success, std::wstring const& errorText)
+{
+	auto const now = GetTickCount64();
+	PruneApiTransfers(now);
+	auto* entry = FindTransfer(download, localFile, remotePath, remoteFile);
+	if (!entry || entry->job.empty()) {
+		return;
+	}
+	if (success) {
+		entry->state = "done";
+		if (entry->expected_bytes >= 0) {
+			entry->transferred_bytes = entry->expected_bytes;
+		}
+		entry->error.clear();
+	}
+	else {
+		entry->state = "failed";
+		entry->error = AuditField(errorText);
+		if (entry->transferred_bytes < 0) {
+			entry->transferred_bytes = 0;
+		}
+	}
+	entry->finished_utc = IsoUtc(std::time(nullptr));
+	entry->job_expiry = now + job_retention_ms;
+	if (!download && success && !entry->session.empty()) {
+		// The upload changed the remote side without refreshing the listing.
+		dirtySessions[entry->session] = now;
+	}
+}
