+fz::json LocalApi::RefreshStatus(fz::json const& id, fz::json const& params)
+{
+	auto const& session = params["session"];
+	if (session.type() != fz::json_type::string) return ErrorResponse(id, -32602, "session must be a string");
+	auto const& wanted = params["token"];
+	if (wanted.type() != fz::json_type::string) return ErrorResponse(id, -32602, "token must be a string");
+	auto* state = Session(session.string_value());
+	if (!state) return ErrorResponse(id, -32602, "Unknown session");
+	auto const now = GetTickCount64();
+	auto& cache = refresh_[state];
+	PruneRefresh(cache, now);
+	RefreshToken const* token{};
+	for (auto const& candidate : cache.tokens) {
+		if (candidate.token == wanted.string_value()) {
+			token = &candidate;
+			break;
+		}
+	}
+	if (!token) return ErrorResponse(id, -32008, "Unknown or expired refresh token");
+	auto listing = state->GetRemoteDir();
+	fz::json result;
+	result["token"] = token->token;
+	result["completed"] = token->completed;
+	result["stale"] = Stale(state, cache, now);
+	result["path"] = listing ? listing->path.GetPath() : state->GetRemotePath().GetPath();
+	result["total"] = listing ? listing->size() : 0;
+	result["fingerprint"] = cache.fingerprint.empty() ? Fingerprint(state, cache) : cache.fingerprint;
+	auto const end = token->completed ? token->completed_at : now;
+	result["waited_ms"] = static_cast<int64_t>(end > token->requested ? end - token->requested : 0);
+	return Reply(id, std::move(result));
+}
